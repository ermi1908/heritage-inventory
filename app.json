{
  "expo": {
    "name": "Eritrean National Built Heritage Inventory",
    "slug": "heritage-inventory-massawa",
    "owner": "ermibs-team",
    "version": "2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heritage-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.nbhi.massawa",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "updates": {
      "enabled": false
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": false,
          "cameraPermission": "Take building survey evidence photographs."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "04d88066-833c-481f-bce7-2fbc4211ad62"
      }
    }
  }
}
